# One installation, for the pipeline's deploy. Copy to
# ~/.config/kraftverk/deploy.env (or wherever KRAFTVERK_DEPLOY_ENV says) on the
# machine that runs ci/forgejo/setup.sh — which gives it to Forgejo — or
# `npm run ship`. Fill it in, and keep it out of any repository: `chmod 600`.
# Read as a shell file.

# The server's Docker. ssh://<user>@<host>, or a Host from ~/.ssh/config
# (ssh://myserver): the user must be able to run `docker` there without sudo,
# with a key, without a password prompt — setup.sh gives the pipeline a key of
# its own. Empty: the Docker of the machine the pipeline runs on.
KRAFTVERK_DEPLOY_HOST=ssh://deploy@192.0.2.10

# The stack's compose project. Its data volume, <project>_kraftverk-data,
# belongs to it — every device, account and reading. Another name starts an
# empty installation beside it.
COMPOSE_PROJECT_NAME=kraftverk

# 0 for a real installation: writes to hardware allowed. docs/DOCKER.md.
READ_ONLY=0

# The public name, through the reverse proxy; empty if there is none.
KRAFTVERK_ALLOWED_HOSTS=kraftverk.example.test

# Seals plugin secrets. Never change it once set: what was sealed with the old
# one cannot be read. `openssl rand -base64 32` for a new installation.
KRAFTVERK_SECRET_KEY=

# Ports, if not the defaults (docs/DOCKER.md#environment).
KRAFTVERK_LAN_PORT=8080
KRAFTVERK_PUBLIC_PORT=8090
