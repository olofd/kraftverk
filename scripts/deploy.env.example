# One installation, for scripts/deploy.sh and the pipeline's deploy
# (docs/DEPLOY.md). Keep the filled-in copy out of every repository — on the
# server, readable by root alone — and point KRAFTVERK_DEPLOY_ENV at it.
# Read as a shell file.

# The stack's compose project. Its data volume, <project>_kraftverk-data,
# belongs to it — every device, account and reading. Another name starts an
# empty installation beside it.
COMPOSE_PROJECT_NAME=kraftverk

# 0 for a real installation: writes to hardware allowed. docs/DOCKER.md.
READ_ONLY=0

# The public name, through the reverse proxy; empty if there is none.
KRAFTVERK_ALLOWED_HOSTS=

# Seals plugin secrets, and the configuration kept beside the database. Never
# change it once set, and keep a copy apart from the server — in a password
# manager: what was sealed with a lost key cannot be read again.
# `openssl rand -base64 32` for a new installation.
KRAFTVERK_SECRET_KEY=

# Ports, if not the defaults (docs/DOCKER.md#environment).
KRAFTVERK_LAN_PORT=8080
KRAFTVERK_PUBLIC_PORT=8090
KRAFTVERK_MQTT_PORT=1883
