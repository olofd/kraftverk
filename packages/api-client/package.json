{
  "name": "@kraftverk/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "The client side of the kraftverk API: every endpoint, typed, plus the shapes the server sends. Shared by the app shell and by device packages, so a device screen can read registers without importing from the app that renders it.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kraftverk/api-contract": "*",
    "@kraftverk/config": "*",
    "@kraftverk/device-sdk": "*",
    "@kraftverk/gateway": "*"
  },
  "peerDependencies": {
    "axios": "*",
    "expo-constants": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    },
    "expo-constants": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
