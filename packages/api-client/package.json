{
  "name": "@kraftverk/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "The kraftverk API from the app's side: a home over HTTP and a server's own calls, on fetch, handed the server's address. Shared by the app and by device packages' screens.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./http": "./src/http.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kraftverk/api-contract": "*",
    "@kraftverk/home-file": "*",
    "@kraftverk/device-sdk": "*",
    "@kraftverk/gateway": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
