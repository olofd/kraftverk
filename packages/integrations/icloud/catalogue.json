{
  "protocols": [
    {
      "id": "icloud-web",
      "label": "iCloud",
      "bindings": {
        "https": {}
      },
      "credentials": {
        "schema": {
          "help": "Your Apple ID and its password stay on this kraftverk: they are how it signs in again when Apple ends a session. Apple asks for a code from one of your devices once.",
          "fields": {
            "appleId": {
              "type": "string",
              "title": "Apple ID",
              "description": "The email address you sign in to iCloud with.",
              "required": true,
              "autocomplete": "username"
            },
            "password": {
              "type": "string",
              "presentation": "secret",
              "title": "Password",
              "required": true,
              "autocomplete": "current-password"
            },
            "session": {
              "type": "string",
              "presentation": "secret",
              "kept": "session",
              "title": "Signed in"
            }
          }
        },
        "actions": [
          {
            "id": "signIn",
            "label": "Sign in",
            "description": "Signs in to iCloud, as icloud.com does: Apple asks for a code from one of your devices, once.",
            "primary": true
          }
        ],
        "first": true,
        "title": "Your Apple Account"
      }
    }
  ],
  "types": [
    {
      "id": "icloud.account",
      "kind": "account",
      "meta": {
        "name": "iCloud account",
        "brand": "Apple",
        "category": "account",
        "icon": "cloud",
        "description": "Your Apple ID, signed into as icloud.com is: every device in its Find My — your family’s included — is found, each added as a device of its own, with where it is and how charged.",
        "support": "experimental",
        "supportNote": "Ported from Home Assistant’s iCloud integration; Apple changes its sign-in often."
      },
      "config": {
        "fields": {}
      },
      "connections": [
        {
          "id": "icloud",
          "label": "iCloud",
          "description": "Through your Apple ID, as icloud.com is: Find My, the family’s devices included.",
          "protocol": "icloud-web",
          "transport": "https",
          "address": "https://setup.icloud.com",
          "reach": "cloud",
          "updates": "poll",
          "platforms": [
            "system"
          ],
          "needs": {
            "trusted": "your Apple ID’s password stays with the server that signs in with it"
          }
        }
      ],
      "simulation": {
        "fields": {
          "latitude": {
            "type": "number",
            "title": "Where the simulated family lives: latitude",
            "default": 59.3,
            "min": -90,
            "max": 90
          },
          "longitude": {
            "type": "number",
            "title": "Where the simulated family lives: longitude",
            "default": 18,
            "min": -180,
            "max": 180
          }
        }
      },
      "bridge": {
        "fallback": "icloud.device"
      },
      "description": {
        "parts": [
          {
            "id": "main",
            "label": "Account",
            "kind": "device",
            "icon": "user"
          }
        ],
        "attributes": [
          {
            "key": "devices",
            "label": "Devices in Find My",
            "value": {
              "type": "number",
              "integer": true
            },
            "category": "diagnostic"
          }
        ]
      },
      "automation": false
    },
    {
      "id": "icloud.device",
      "kind": "hardware",
      "meta": {
        "name": "Device in Find My",
        "brand": "Apple",
        "category": "phone",
        "icon": "smartphone",
        "description": "A phone, tablet, Mac or AirPods in Find My — yours or your family’s — through your iCloud account: where it is, how charged, and a sound played on it.",
        "support": "experimental",
        "supportNote": "Ported from Home Assistant’s iCloud integration: read from Find My on iCloud."
      },
      "config": {
        "fields": {}
      },
      "connections": [
        {
          "id": "account",
          "label": "Through your iCloud account",
          "description": "Through the iCloud account its Find My is on, which asks Apple for every device at once. Needs the internet.",
          "through": [
            "icloud.account"
          ],
          "reach": "cloud",
          "updates": "poll"
        }
      ],
      "tools": {
        "lostMode": {
          "label": "Lost mode",
          "description": "Locks it, and shows a message and a number to call on its screen. It stays locked until it is found and unlocked with its passcode.",
          "input": {
            "fields": {
              "phone": {
                "type": "string",
                "title": "A number to call",
                "required": true
              },
              "text": {
                "type": "string",
                "title": "Message",
                "default": "This device is lost. Please call the number below."
              }
            }
          },
          "answer": {
            "type": "boolean"
          },
          "writes": true,
          "confirm": "Its owner cannot use it until it is unlocked with its passcode."
        }
      },
      "description": {
        "parts": [
          {
            "id": "main",
            "label": "Device",
            "kind": "device",
            "offers": [
              "identify"
            ]
          }
        ],
        "attributes": [
          {
            "key": "position",
            "label": "Where it is",
            "value": {
              "type": "object",
              "fields": {
                "latitude": {
                  "type": "number",
                  "unit": "°",
                  "min": -90,
                  "max": 90
                },
                "longitude": {
                  "type": "number",
                  "unit": "°",
                  "min": -180,
                  "max": 180
                },
                "accuracy": {
                  "type": "number",
                  "unit": "m",
                  "min": 0
                }
              },
              "required": [
                "latitude",
                "longitude"
              ]
            },
            "means": "position",
            "category": "primary",
            "currentFor": 3600000
          },
          {
            "key": "charge",
            "label": "Charge",
            "value": {
              "type": "number",
              "unit": "%",
              "min": 0,
              "max": 100
            },
            "means": "charge",
            "currentFor": 3600000
          },
          {
            "key": "charging",
            "label": "Charging",
            "value": {
              "type": "boolean",
              "words": {
                "true": "Charging",
                "false": "Not charging"
              }
            },
            "currentFor": 3600000
          },
          {
            "key": "owner",
            "label": "Whose it is",
            "description": "The family member it belongs to, when it is not the account’s own.",
            "value": {
              "type": "string"
            },
            "category": "diagnostic"
          }
        ]
      },
      "automation": false
    }
  ]
}
