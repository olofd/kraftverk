{
  "name": "@kraftverk/integration-niu",
  "version": "0.1.0",
  "private": true,
  "description": "NIU as a platform: electric scooters read from NIU's cloud with their owner's account — the builder a scooter model is made with, the generic scooter and its screens.",
  "type": "module",
  "main": "./src/index.ts",
  "kraftverk": {
    "integration": {
      "id": "niu",
      "name": "NIU",
      "types": [
        {
          "id": "niu.scooter",
          "entry": "./src/scooter.ts",
          "ui": "./ui/index.ts"
        }
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./scooter": "./src/scooter.ts",
    "./ui": "./ui/index.ts"
  },
  "scripts": {
    "test": "node ../../../scripts/run-bun.mjs test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kraftverk/device-sdk": "*",
    "@kraftverk/protocol-niu-cloud": "*"
  },
  "peerDependencies": {
    "@kraftverk/api-client": "*",
    "@kraftverk/ui": "*",
    "react": "*",
    "tamagui": "*"
  },
  "peerDependenciesMeta": {
    "@kraftverk/api-client": {
      "optional": true
    },
    "@kraftverk/ui": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "tamagui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
