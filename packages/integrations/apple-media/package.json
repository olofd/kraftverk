{
  "name": "@kraftverk/integration-apple-media",
  "version": "0.1.0",
  "private": true,
  "description": "Apple TV on the home network: Companion, paired once with the PIN the TV shows (HomeKit pairing), every connection verified and sealed, and the remote's session. Ported from pyatv.",
  "type": "module",
  "main": "./src/index.ts",
  "kraftverk": {
    "integration": {
      "id": "apple-media",
      "name": "Apple Media",
      "protocols": [
        "./src/protocol/index.ts"
      ],
      "types": []
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./testing": "./test/played.ts"
  },
  "scripts": {
    "test": "node ../../../scripts/run-bun.mjs test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kraftverk/device-sdk": "*",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
