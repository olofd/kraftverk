    "words": [
      "Sydpower",
      "AFERIY",
      "FOSSiBOT",
      "ABOK",
      "Eco Play",
      "BrightEMS"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol/index.ts"
  },
  "scripts": {
    "test": "node ../../../scripts/run-bun.mjs test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kraftverk/device-sdk": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
