{
  "name": "@kraftverk/integration-sydpower",
  "version": "0.1.0",
  "private": true,
  "description": "Sydpower as a platform: the power stations on its stack — AFERIY, FOSSiBOT, ABOK, Eco Play — and the two ways one is reached, Wi-Fi through this home's broker and Bluetooth.",
