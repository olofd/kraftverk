{
  "name": "@kraftverk/integration-open-meteo",
  "version": "0.2.0",
  "private": true,
  "description": "Open-Meteo as a platform: its weather forecast for a place as a service, with no account and no key, and what the forecast brings to automations.",
  "type": "module",
  "main": "src/type.ts",
  "kraftverk": {
    "integration": {
      "id": "open-meteo",
      "name": "Open-Meteo",
      "protocols": [
        "./src/protocol/index.ts"
      ],
      "types": [
        {
          "id": "open-meteo.weather",
          "entry": "./src/type.ts",
          "automation": "./src/automation.ts"
        }
      ]
    }
  },
  "exports": {
    ".": "./src/type.ts",
    "./automation": "./src/automation.ts",
    "./protocol": "./src/protocol/index.ts"
  },
  "scripts": {
    "test": "node ../../../scripts/run-bun.mjs test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kraftverk/automation": "*",
    "@kraftverk/device-sdk": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
