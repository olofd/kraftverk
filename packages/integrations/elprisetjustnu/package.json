{
  "name": "@kraftverk/integration-elprisetjustnu",
  "version": "0.1.0",
  "private": true,
  "description": "elprisetjustnu.se as a platform: Sweden's electricity prices as a service — the price now and the hour's rank among the day's, for a price area, with no account and no key.",
  "type": "module",
  "main": "src/type.ts",
  "kraftverk": {
    "integration": {
      "id": "elprisetjustnu",
      "name": "Elpriset just nu",
      "protocols": [
        "./src/protocol/index.ts"
      ],
      "types": [
        {
          "id": "elprisetjustnu.prices",
          "entry": "./src/type.ts"
        }
      ]
    }
  },
  "exports": {
    ".": "./src/type.ts",
    "./protocol": "./src/protocol/index.ts"
  },
  "scripts": {
    "test": "node ../../../scripts/run-bun.mjs test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kraftverk/device-sdk": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
