{
  "name": "@kraftverk/transport-https",
  "version": "0.2.0",
  "private": true,
  "description": "The internet, over HTTPS, for services: one origin per channel, so a device type reaches the API it was set up with and nothing else.",
  "type": "module",
  "main": "src/index.ts",
  "kraftverk": {
    "transport": {
      "definition": "./src/index.ts",
      "server": "./src/server.ts",
      "web": "./src/web.ts",
      "native": "./src/web.ts"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./web": "./src/web.ts"
  },
  "scripts": {
    "test": "node ../../../scripts/run-bun.mjs test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kraftverk/device-sdk": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
