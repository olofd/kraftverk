{
  "name": "@kraftverk/device-aferiy-p280",
  "version": "0.1.0",
  "private": true,
  "description": "The AFERIY P280 as a device type: what it measures, what it can do, what it remembers, how to set one up — and the screens that are specific to it.",
  "type": "module",
  "main": "src/index.ts",
  "kraftverk": {
    "deviceType": "./src/type.ts",
    "ui": "./ui/index.ts",
    "words": ["p280", "StationStatus", "StationSettings", "gridRelay", "core.station"],
    "assets": {
      "image": "./assets/device-image.png"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./type": "./src/type.ts",
    "./ui": "./ui/index.ts",
    "./ui/energy-flow": "./ui/energy-flow.tsx",
    "./ui/settings": "./ui/settings.tsx",
    "./ui/registers": "./ui/registers.tsx",
    "./ui/contract": "./ui/contract.ts",
    "./ui/dashboard": "./ui/dashboard.tsx",
    "./assets/device-image.png": "./assets/device-image.png"
  },
  "scripts": {
    "test": "node ../../../scripts/run-bun.mjs test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kraftverk/device-sdk": "*",
    "@kraftverk/protocol-sydpower": "*"
  },
  "peerDependencies": {
    "@kraftverk/api-client": "*",
    "@kraftverk/ui": "*",
    "react": "*",
    "tamagui": "*"
  },
  "peerDependenciesMeta": {
    "@kraftverk/api-client": {
      "optional": true
    },
    "@kraftverk/ui": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "tamagui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
