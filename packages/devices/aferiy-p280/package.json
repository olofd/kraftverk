{
  "name": "@kraftverk/device-aferiy-p280",
  "version": "0.1.0",
  "private": true,
  "description": "The AFERIY P280, a product on the Sydpower platform: what it measures, what it can do, what it remembers — and the screens that are its own.",
  "type": "module",
  "main": "src/index.ts",
  "kraftverk": {
    "device": {
      "integration": "sydpower",
      "types": [
        {
          "id": "aferiy.p280",
          "entry": "./src/type.ts",
          "ui": "./ui/index.ts",
          "images": [
            "./assets/image-1.png"
          ]
        }
      ]
    },
    "words": [
      "p280",
      "StationStatus",
      "StationSettings",
      "gridRelay",
      "core.station"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./type": "./src/type.ts",
    "./ui": "./ui/index.ts",
    "./ui/energy-flow": "./ui/energy-flow.tsx",
    "./ui/settings": "./ui/settings.tsx",
    "./ui/registers": "./ui/registers.tsx",
    "./ui/contract": "./ui/contract.ts",
    "./ui/dashboard": "./ui/dashboard.tsx",
    "./assets/image-1.png": "./assets/image-1.png"
  },
  "scripts": {
    "test": "node ../../../scripts/run-bun.mjs test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kraftverk/device-sdk": "*",
    "@kraftverk/integration-sydpower": "*"
  },
  "peerDependencies": {
    "@kraftverk/api-client": "*",
    "@kraftverk/ui": "*",
    "react": "*",
    "react-native-svg": "*",
    "tamagui": "*"
  },
  "peerDependenciesMeta": {
    "@kraftverk/api-client": {
      "optional": true
    },
    "@kraftverk/ui": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "tamagui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kraftverk/automation": "*",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
