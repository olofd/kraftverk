{
  "name": "@kraftverk/device-apple-tv",
  "version": "0.1.0",
  "private": true,
  "description": "Apple TV on the home network, over Companion as its own remote reaches it: on and off, play and pause, the remote keys, apps and volume, updates pushed. Built on apple-media; ported from pyatv.",
  "type": "module",
  "main": "./src/type.ts",
  "kraftverk": {
    "device": {
      "integration": "apple-media",
      "types": [
        {
          "id": "apple-media.tv",
          "entry": "./src/type.ts"
        }
      ]
    }
  },
  "exports": {
    ".": "./src/type.ts",
    "./type": "./src/type.ts"
  },
  "scripts": {
    "test": "node ../../../scripts/run-bun.mjs test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kraftverk/device-sdk": "*",
    "@kraftverk/integration-apple-media": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
