{
  "name": "@kraftverk/device-tuya-zigbee-plug",
  "version": "0.1.0",
  "private": true,
  "description": "A 16 A Zigbee energy plug paired with a Tuya Zigbee gateway, a product on Tuya: its datapoint layout on the Tuya socket, reached through the gateway on the home network with no cloud.",
  "type": "module",
  "main": "src/type.ts",
  "kraftverk": {
    "device": {
      "integration": "tuya",
      "types": [
        {
          "id": "tuya.zigbee-plug",
          "entry": "./src/type.ts"
        }
      ]
    }
  },
  "exports": {
    ".": "./src/type.ts",
    "./type": "./src/type.ts"
  },
  "scripts": {
    "test": "node ../../../scripts/run-bun.mjs test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kraftverk/device-sdk": "*",
    "@kraftverk/integration-tuya": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
