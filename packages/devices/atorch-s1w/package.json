{
  "name": "@kraftverk/device-atorch-s1w",
  "version": "0.2.0",
  "private": true,
  "description": "The ATORCH S1W / S1WP / S1BW, a product on Tuya: its datapoint layout on the Tuya socket, and its own screens.",
  "type": "module",
  "main": "src/type.ts",
  "kraftverk": {
    "device": {
      "integration": "tuya",
      "types": [
        {
          "id": "atorch.s1w",
          "entry": "./src/type.ts",
          "ui": "./ui/index.ts",
          "images": [
            "./assets/image-1.png"
          ]
        }
      ]
    }
  },
  "exports": {
    ".": "./src/type.ts",
    "./type": "./src/type.ts",
    "./ui": "./ui/index.ts",
    "./assets/image-1.png": "./assets/image-1.png"
  },
  "scripts": {
    "test": "node ../../../scripts/run-bun.mjs test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kraftverk/device-sdk": "*",
    "@kraftverk/integration-tuya": "*"
  },
  "peerDependencies": {
    "@kraftverk/api-client": "*",
    "@kraftverk/ui": "*",
    "react": "*",
    "tamagui": "*"
  },
  "peerDependenciesMeta": {
    "@kraftverk/api-client": {
      "optional": true
    },
    "@kraftverk/ui": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "tamagui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
