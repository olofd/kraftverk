        "category": "smart-plug"
      },
      "config": {
        "fields": {
          "profile": {
            "type": "enum",
            "title": "Datapoint layout",
            "description": "Which datapoint is the relay, what scale each measurement is sent in, and which settings the plug has.",
            "default": "atorch-s1",
            "options": [
              {
                "value": "atorch-s1",
                "label": "ATORCH S1W / S1WP / S1BW"
              }
            ]
          },
          "pollSeconds": {
            "type": "number",
            "title": "Poll interval",
            "default": 10,
            "min": 2,
            "max": 300,
            "unit": "s",
            "integer": true
          }
        }
      },
      "connections": [
        {
          "id": "lan",
          "label": "Home network",
          "description": "Straight to the plug on your home network, with no cloud. Needs its local key, once.",
