{
  "name": "@kraftverk/device-niu-uqi-gt",
  "version": "0.1.0",
  "private": true,
  "description": "The NIU UQi GT (and GT Sport), a product on NIU: the common NIU scooter with its name, models and pictures and, as it is mapped, what only it does.",
  "type": "module",
  "main": "./src/type.ts",
  "kraftverk": {
    "device": {
      "integration": "niu",
      "types": [
        {
          "id": "niu.uqi-gt",
          "entry": "./src/type.ts",
          "ui": "./ui/index.ts",
          "images": [
            "./assets/image-1.png",
            "./assets/image-2.png",
            "./assets/image-3.png"
          ]
        }
      ]
    }
  },
  "exports": {
    ".": "./src/type.ts",
    "./type": "./src/type.ts",
    "./ui": "./ui/index.ts",
    "./assets/image-1.png": "./assets/image-1.png",
    "./assets/image-2.png": "./assets/image-2.png",
    "./assets/image-3.png": "./assets/image-3.png"
  },
  "scripts": {
    "test": "node ../../../scripts/run-bun.mjs test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kraftverk/device-sdk": "*",
    "@kraftverk/integration-niu": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
