{
  "name": "@kraftverk/hub",
  "version": "0.1.0",
  "private": true,
  "description": "A kraftverk home, running: what is installed, its devices held and viewed, setup, history, attention, automations, its configuration and the live stream, wired from the shared packages over the ports the place it runs gives it. The server runs one behind HTTP; the app one of its own with no server.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "test": "node ../../scripts/run-bun.mjs test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kraftverk/api-contract": "*",
    "@kraftverk/automation": "*",
    "@kraftverk/automation-engine": "*",
    "@kraftverk/device-sdk": "*",
    "@kraftverk/gateway": "*",
    "@kraftverk/holder": "*",
    "@kraftverk/home-file": "*",
    "@kraftverk/store": "*",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
