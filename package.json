{
  "name": "aferiy-powerstation-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run server\" \"npm run web\"",
    "server": "npm run dev --workspace server",
    "web": "npm run web --workspace client",
    "ios": "npm run ios --workspace client",
    "android": "npm run android --workspace client",
    "start": "npm run start --workspace client",
    "typecheck": "npm run typecheck --workspace client && npm run typecheck --workspace server"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
