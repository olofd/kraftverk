{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "server"],
      "port": 3333
    },
    {
      "name": "server:write",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "server:write"],
      "port": 3333
    },
    {
      "name": "server:scratch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/run-bun.mjs", "server/src/index.ts"],
      "env": { "KRAFTVERK_DB": "server/data/scratch/kraftverk.db", "PORT": "3334" },
      "port": 3334
    },
    {
      "name": "server:ui-check",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/run-bun.mjs", "server/src/index.ts"],
      "env": { "KRAFTVERK_DB": "server/data/scratch/ui-check.db", "KRAFTVERK_LOG_DIR": "server/data/scratch/ui-check-logs", "PORT": "3334" },
      "port": 3334
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web"],
      "port": 8081
    }
  ]
}
