{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "server"],
      "port": 3333
    },
    {
      "name": "server:ble",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "server:ble"],
      "port": 3333
    },
    {
      "name": "server:ble:write",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "server:ble:write"],
      "port": 3333
    },
    {
      "name": "server:wifi",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "server:wifi"],
      "port": 3333
    },
    {
      "name": "server:device:write",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "server:device:write"],
      "port": 3333
    },
    {
      "name": "server:scratch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/run-bun.mjs", "server/src/index.ts"],
      "env": { "KRAFTVERK_DB": "server/data/scratch/kraftverk.db" },
      "port": 3333
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web"],
      "port": 8081
    }
  ]
}
