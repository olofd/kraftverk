node_modules/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Runtime state written by the server: the database, chosen device binding,
# station settings cache, register baselines. Machine- and device-specific,
# never committed.
server/data/

# The passphrase that authorises wiping the database. Already inside
# server/data/, but named separately so it survives that rule ever being
# relaxed: committing it would hand anyone who can read the repository the
# ability to empty a running server.
**/reset-secret

# Expo / Metro
.expo/
.expo-shared/
**/.expo/
dist/
web-build/
.tamagui/
expo-env.d.ts

# Native projects are generated by prebuild
android/
ios/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
