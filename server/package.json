{
  "name": "aferiy-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "dev:device": "bun --hot src/index.ts --driver=device --read-only",
    "dev:device:write": "bun --hot src/index.ts --driver=device",
    "dev:ble": "bun --hot src/index.ts --driver=ble --read-only",
    "dev:ble:write": "bun --hot src/index.ts --driver=ble",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stoprocent/noble": "^2.7.1",
    "aedes": "^1.1.1",
    "hono": "^4.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
