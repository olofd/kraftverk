{
  "name": "kraftverk-client",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "//web": "The app in a browser, and a browser's own home (the hub in its worker) built beside it, again on every change.",
    "web": "concurrently -k -n worker,expo -c gray,cyan \"node scripts/build-home-worker.mjs --watch\" \"expo start --web\"",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "web:prod": "node scripts/build-home-worker.mjs && expo start --web --no-dev --minify",
    "build:home-worker": "node scripts/build-home-worker.mjs",
    "build:web": "node scripts/build-home-worker.mjs && expo export --platform web --output-dir dist"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@expo/vector-icons": "^15.1.1",
    "@jitl/quickjs-ng-wasmfile-release-sync": "^0.32.0",
    "@kraftverk/api-client": "*",
    "@kraftverk/automation": "*",
    "@kraftverk/automation-engine": "*",
    "@kraftverk/device-sdk": "*",
    "@kraftverk/home-file": "*",
    "@kraftverk/hub": "*",
    "@kraftverk/identity": "*",
    "@kraftverk/map": "*",
    "@kraftverk/message-port": "*",
    "@kraftverk/script-wasm": "*",
    "@kraftverk/store": "*",
    "@kraftverk/ui": "*",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "@tamagui/animations-react-native": "^2.7.4",
    "@tamagui/font-inter": "^2.7.4",
    "codemirror-json-schema": "^0.8.1",
    "expo": "~57.0.26",
    "expo-apple-authentication": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "^57.0.1",
    "expo-system-ui": "~57.0.4",
    "maplibre-gl": "^6.13.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "tamagui": "^2.7.4",
    "toqr": "^0.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@tamagui/babel-plugin": "^2.7.4",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.4",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3"
  }
}
